{
  "name": "exvitrin-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@supabase/supabase-js": "^2.39.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "dotenv": "^16.3.1",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.6.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); ['splash-screen','status-bar','share','push-notifications','app'].forEach(p=>{const f='./node_modules/@capacitor/'+p+'/Package.swift'; if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8'); c=c.replace(/swift-tools-version: 6.0/g, 'swift-tools-version: 5.9'); if(!c.includes('enableExperimentalFeature')){c=c.replace(/(path:\\s*\\\"ios\\/Sources\\/[^\\\"]+\\\")/g, '$1,\\n            swiftSettings: [.enableExperimentalFeature(\\\"NonescapableTypes\\\")]');} fs.writeFileSync(f, c);}})\"",
    "start": "react-scripts start",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "migrate": "node scripts/migrate-mock-data.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-config-react-app": "^7.0.1"
  }
}
