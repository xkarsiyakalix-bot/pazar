{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/og.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/listing/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot).*"
        }
      ],
      "destination": "/api/og?id=:id&type=listing"
    },
    {
      "source": "/seller/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot).*"
        }
      ],
      "destination": "/api/og?id=:id&type=seller"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
